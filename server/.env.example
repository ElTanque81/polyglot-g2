# Copy to .env (never commit .env)
PORT=8787
# 32+ random characters, encrypts Telegram sessions at rest. e.g. `openssl rand -hex 32`
SERVER_SECRET=
DATA_DIR=./data

# Telegram client API credentials from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# LLM for triage, reply drafts, cleanup, digest, translation
# AI_PROVIDER: otari (Mozilla.ai gateway, https://otari.ai), anthropic or openai
AI_PROVIDER=otari
OTARI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional: defaults are alibaba/qwen3-235b-a22b-instruct-2507 (otari), claude-haiku-5-5 (anthropic), gpt-4o-mini (openai)
AI_MODEL=

# Whisper speech-to-text: groq or openai
STT_PROVIDER=groq
GROQ_API_KEY=

# Keyless demo account with fictional chats
ALLOW_DEMO=true
